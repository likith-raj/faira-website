# Supabase — create a project at supabase.com and paste these here.
# Without these keys the site runs in local mode: enquiries are saved to
# the browser's localStorage and admin login uses demo password "faira123".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADMIN_PASSWORD=faira123

# Email notifications (optional — Resend)
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini — powers the live voice & chat demos (src/app/api/chat/route.ts).
# Free key: https://aistudio.google.com/apikey  — server-side only, never NEXT_PUBLIC_*.
# Without it the demos run but say the AI brain is not connected.
GEMINI_API_KEY=
# Optional: pin a model. Empty = discover the best available flash model at runtime.
GEMINI_MODEL=

# RapidAPI — live train status for /demos/train-voice.
# Subscribe to the free "Indian Railway IRCTC" app on rapidapi.com and paste the key.
# The host must be exactly this (no "s" in "railway") or every call returns 404.
# Without a valid key that demo clearly labels its answers as SAMPLE data (never pretend live).
RAPIDAPI_KEY=
RAPIDAPI_HOST=indian-railway-irctc.p.rapidapi.com
# Optional: paste the exact request URL from the app's "Endpoints" tab (RapidAPI shows it under
# Code → Node.js). Use {no} where the train number goes. Default:
# RAPIDAPI_TRAIN_URL=https://indian-railway-irctc.p.rapidapi.com/api/v1/liveTrainStatus?trainNo={no}&startDay=0
